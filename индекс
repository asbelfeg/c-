@model PaginationViewModel<TodoItem>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Мой список дел</h1>
    <a asp-action="Create" class="btn btn-primary">Добавить задачу</a>
</div>

<table class="table table-hover">
    <thead class="table-light">
        <tr>
            <th>Заголовок</th>
            <th>Описание</th>
            <th>Статус</th>
            <th>Дата создания</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td><strong>@item.Title</strong></td>
                <td>@item.Description</td>
                <td>
                    @if (item.IsCompleted)
                    {
                        <span class="badge bg-success">Выполнено</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">В работе</span>
                    }
                </td>
                <td>@item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Изменить</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<nav aria-label="Page navigation">
    <ul class="pagination justify-content-center">
        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)">Назад</a>
        </li>

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
            </li>
        }

        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)">Вперед</a>
        </li>
    </ul>
</nav>
